# Copy these into your host's "Environment" settings (never commit real values).
PULANOVA_ENV=production
PULANOVA_SECRET=put-a-long-random-text-here
PULANOVA_SECURE_COOKIES=1
PULANOVA_PROXY=1
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Shown on the Privacy page (who to contact, who runs the site)
PULANOVA_CONTACT_EMAIL=you@example.com
PULANOVA_OPERATOR=Your Name or Organisation

# REQUIRED in production for password-reset links (your public address, no trailing slash)
PULANOVA_BASE_URL=https://your-app.onrender.com

# Email for reset links. Render's free tier blocks SMTP, so use Brevo's web API:
BREVO_API_KEY=your-brevo-api-key
MAIL_FROM=your-verified-sender@example.com   # must be a sender verified in Brevo
MAIL_FROM_NAME=PULANOVA AI
# Alternative on your own PC / hosts that allow SMTP (leave BREVO_API_KEY empty):
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=...
# SMTP_PASSWORD=...
